{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIGauge",
  "version": "1.0.0",
  "identifier": "com.aigauge.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/dev-or-reuse.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIGauge",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "tray-popup",
        "title": "AIGauge Quick View",
        "width": 420,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": false,
        "url": "/#/tray"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.anthropic.com https://*.openai.com https://*.github.com https://*.google.com https://*.amazonaws.com https://api.jetbrains.ai https://chatgpt.com https://api.claude.ai https://cloudcode-pa.googleapis.com https://status.openai.com https://status.anthropic.com https://status.cloud.google.com; style-src 'self' 'unsafe-inline'",
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../dist-isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/everygoodnews-ship-it/aigauge/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER"
    }
  }
}
