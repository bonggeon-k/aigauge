{
  "name": "aigauge",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:installer:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/build-test-installers-windows.ps1",
    "build:installer:macos": "./scripts/build-test-installers-macos.sh",
    "visual:baseline": "node scripts/capture-visual-baseline.mjs",
    "doctor:providers": "node scripts/provider-env-check.mjs",
    "release:check": "pnpm doctor:providers && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && pnpm lint && pnpm build && (cd src-tauri && cargo audit) && pnpm audit --audit-level=high",
    "release:oss-check": "node ./scripts/release-readiness.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@eslint/js": "^9.39.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.7",
      "@hono/node-server": "1.19.10",
      "express-rate-limit": "8.2.2",
      "flatted": "3.4.2"
    }
  }
}
